# Backend API URL (required)
# Development: http://localhost:8000
# Production: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock Auth Mode (required for Phase 2 Frontend)
# Set to 'true' to use MockAuthService (localStorage-based mock auth)
# Set to 'false' to use BetterAuthService (real Better Auth integration)
NEXT_PUBLIC_USE_MOCK_AUTH=true

# Better Auth Secret (required for Phase 2 Backend)
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=your-secret-here

# Error tracking (optional - production only)
# NEXT_PUBLIC_SENTRY_DSN=

# Analytics (optional - production only)
# NEXT_PUBLIC_GA_ID=
